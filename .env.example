# Les variables sont lues par application : copier plutôt
#   apps/api/.env.example → apps/api/.env
#   apps/web/.env.example → apps/web/.env
# Ce fichier n'en est qu'un récapitulatif (voir README.md, « Variables d'environnement »).

# --- apps/api ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalyaro?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
VITE_ORIGIN="http://localhost:5173"

# --- packages/ai-service (lu par l'API) ---
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- stockage R2 (lu par l'API) ---
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kalyaro-uploads"

# --- apps/web ---
VITE_API_URL="http://localhost:4000"
