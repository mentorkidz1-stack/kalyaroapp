DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalyaro?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"

# Origine(s) autorisée(s) pour le CORS — liste séparée par des virgules
VITE_ORIGIN="http://localhost:5173"

# Service IA — AI_PROVIDER choisit l'adaptateur ("gemini" ou "anthropic")
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Stockage des fichiers (PDF, photos) — Cloudflare R2 (compatible S3)
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kalyaro-uploads"
